# Copie para .env (local) ou cadastre na Vercel (Settings > Environment Variables).
# Só valores públicos no navegador: a chave publishable do Supabase foi feita para isso.
# Nunca coloque chave secreta (service_role / sb_secret_) em nenhuma variável deste projeto.

# Supabase (Project Settings > API): lidos pelo navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Os mesmos, lidos pelo servidor quando os VITE_ faltam.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Nuvemshop (opcional, recomendado): fotos, preços e licenças ao vivo do catálogo inteiro.
# Só no servidor (sem VITE_). Token de app com permissão apenas de leitura de produtos.
NUVEMSHOP_STORE_ID=
NUVEMSHOP_TOKEN=

# Google Tag Manager da loja (opcional): GTM-NTMSLZ5H. Carrega só em links.lojasoccergames.com.br.
VITE_GTM_ID=
# Microsoft Clarity (opcional): ID de um projeto "Links Soccer".
VITE_CLARITY_ID=
